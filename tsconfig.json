{
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "lib": ["es2023", "dom"],
    "types": ["node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "erasableSyntaxOnly": true,
    "paths": {
      "#/*": ["./src/*"]
    }
  }
}
