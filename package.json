{
  "name": "sync-request-curl",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts",
    "#native-platform-key": "./src/native-platform-key.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nktnet1/sync-request-curl"
  },
  "version": "5.0.0",
  "files": [
    "dist",
    "prebuilds"
  ],
  "scripts": {
    "start": "tsx tests/app/server",
    "dev": "tsx watch --include ./tests/app ./tests/app/server.ts",
    "test": "node scripts/build-native.ts --if-needed && vitest run",
    "tc": "node scripts/build-native.ts --if-needed && vitest run --coverage",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "build:native": "node scripts/build-native.ts",
    "stage:native": "node scripts/stage-native.ts",
    "verify:prebuilds": "node scripts/verify-prebuilds.ts",
    "prepack": "pnpm run build && pnpm run verify:prebuilds",
    "build:linux:gnu": "node scripts/linux-prebuild.ts --libc=gnu --mode=build",
    "build:linux:musl": "node scripts/linux-prebuild.ts --libc=musl --mode=build",
    "test:linux:musl": "node scripts/linux-prebuild.ts --libc=musl --mode=test"
  },
  "keywords": [
    "sync",
    "sync-request",
    "synchronous",
    "request",
    "fast",
    "quick",
    "speed",
    "performance",
    "http",
    "https",
    "curl",
    "libcurl",
    "comp1531"
  ],
  "author": "Khiet Tam Nguyen",
  "license": "MIT",
  "description": "Fast synchronous HTTP requests for Node.js using an in-process Node-API binding to libcurl. No install scripts or local native compilation required.",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@hono/node-server": "^2.1.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "5.0.1",
    "hono": "^4.13.8",
    "lefthook": "2.1.14",
    "sync-dev-server": "^1.1.3",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./errors": {
      "import": "./dist/errors.mjs",
      "require": "./dist/errors.cjs"
    },
    "./package.json": "./package.json"
  }
}
