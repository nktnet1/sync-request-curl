{
  "name": "sync-request-curl",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts",
    "#scripts/*": "./scripts/*.ts",
    "#tests/*": "./tests/*.ts",
    "#typedoc/*": "./typedoc/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nktnet1/sync-request-curl"
  },
  "version": "5.1.0-beta.1",
  "files": [
    "dist",
    "native/src",
    "native/Cargo.toml",
    "native/Cargo.lock",
    "native/build.rs",
    "native/build.mjs",
    "native/README.md",
    "rust-toolchain.toml"
  ],
  "bin": {
    "sync-request-curl-build": "./native/build.mjs"
  },
  "scripts": {
    "bootstrap:native": "node scripts/bootstrap-native-packages.ts",
    "build": "tsdown && pnpm build:source-tools && pnpm build:worker",
    "build:linux:gnu": "node scripts/linux-prebuild.ts --libc=gnu --mode=build",
    "build:linux:musl": "node scripts/linux-prebuild.ts --libc=musl --mode=build",
    "build:native": "node scripts/build-native.ts",
    "build:source-tools": "tsdown --config tsdown.source-build.config.ts",
    "build:worker": "tsdown --config tsdown.worker.config.ts",
    "check": "biome check",
    "dev": "tsx watch --include ./tests/app ./tests/app/server.ts",
    "docs:check": "node typedoc/generate.ts --check",
    "docs:gen": "node typedoc/generate.ts",
    "format": "biome format",
    "lint": "biome lint",
    "prepack": "pnpm build",
    "prepare:release-packages": "node scripts/prepare-release-packages.ts",
    "prepublishOnly": "node scripts/prevent-direct-publish.ts",
    "publish:release-packages": "node scripts/publish-release-packages.ts",
    "release:beta": "node scripts/release-beta.ts",
    "smoke:release-registry": "node scripts/smoke-release-registry.ts",
    "stage:native": "node scripts/stage-native.ts",
    "start": "tsx tests/app/server",
    "tc": "pnpm build:worker && node scripts/build-native.ts --if-needed && vitest run --coverage",
    "test": "pnpm build:worker && node scripts/build-native.ts --if-needed && vitest run",
    "test:docs": "vitest run --config vitest.docs.config.ts",
    "test:entrypoints": "tsdown && node --test tests/build/entrypoints.smoke.ts",
    "test:linux:musl": "node scripts/linux-prebuild.ts --libc=musl --mode=test",
    "test:source-build": "pnpm build:source-tools && node --test tests/build/*.check.mjs",
    "test:verdaccio": "node scripts/test-verdaccio.ts",
    "typecheck": "tsc --noEmit",
    "verify:prebuilds": "node scripts/verify-prebuilds.ts"
  },
  "keywords": [
    "sync",
    "sync-request",
    "synchronous",
    "request",
    "fast",
    "quick",
    "speed",
    "performance",
    "http",
    "https",
    "curl",
    "libcurl",
    "then-request",
    "http-basic",
    "comp1531"
  ],
  "author": "Khiet Tam Nguyen",
  "license": "MIT",
  "description": "A high-performance Node.js alternative to sync-request for making synchronous web requests.",
  "dependencies": {
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@hono/node-server": "^2.1.3",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "hono": "^4.13.12",
    "lefthook": "2.1.16",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-plugin-no-inherit": "^1.6.1",
    "typedoc-plugin-valibot": "^1.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.8.1",
  "main": "./dist/index.cjs",
  "module": "./dist/index-esm.mjs",
  "types": "./dist/index.d.cts",
  "engines": {
    "node": ">=16.17.0"
  },
  "browserslist": [
    "node >= 16.17.0"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index-esm.d.mts",
        "default": "./dist/index-esm.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  }
}
